{
  "name": "astrozenit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AstroZenit: centrum obserwacji i poznawania nocnego nieba",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:catalog": "node scripts/build-catalog.mjs",
    "verify:astro": "node scripts/verify-astro.mjs",
    "check:dash": "node scripts/check-dash.mjs",
    "build:textures": "node scripts/build-textures.mjs",
    "build:satellites": "node scripts/build-satellites.mjs",
    "verify:conditions": "node scripts/run-ts.mjs scripts/verify-conditions.ts",
    "verify": "npm run verify:astro && npm run verify:conditions && npm run verify:compass && npm run check:dash",
    "dev:https": "ZENIT_HTTPS=1 vite",
    "build:photos": "node scripts/build-photos.mjs",
    "fetch:news": "node scripts/fetch-news.mjs",
    "verify:compass": "node scripts/run-ts.mjs scripts/verify-compass.ts"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.1",
    "satellite.js": "^6.0.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jpeg-js": "^0.4.4",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
