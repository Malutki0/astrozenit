# Wzór pliku ze zmiennymi środowiskowymi. Skopiuj do .env i uzupełnij.
# Sam .env jest w .gitignore i nigdy nie trafia do repozytorium.

# Tłumaczenie aktualności NASA na polski. Bez tego klucza pobieranie działa,
# ale nowe wpisy zostają po angielsku. Na hostingu wpisuje się go w sekretach
# GitHuba, nie tutaj.
ANTHROPIC_API_KEY=

# Klucz do interfejsu NASA. Bez niego używany jest klucz pokazowy DEMO_KEY
# z limitem dziesięciu zapytań na godzinę, co przy jednym pobraniu na dobę wystarcza.
NASA_API_KEY=

# KONTA: wybierz jedną z dwóch dróg albo zostaw obie puste.
#
# Droga pierwsza, zalecana i darmowa: Supabase. Daje bazę razem z wysyłką poczty,
# czyli z potwierdzaniem adresu i odzyskiwaniem hasła. Krok po kroku w docs/start-za-darmo.md.
# Klucz anon jest publiczny z założenia i ma prawo być w kodzie strony: dostępu pilnują
# zasady ochrony wierszy w bazie, uruchamiane plikiem server/schema-supabase.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Droga druga: własne zaplecze zgodne z server/api.md. Działającą wersję w PHP razem
# ze schematem dla MySQL zawiera katalog server. Wymaga hostingu z PHP i osobnego
# podpięcia wysyłki poczty. Opis w docs/baza-mysql.md.
VITE_API_URL=
