z","en":"Big Dipper (Plough)","note":"Siedem gwiazd Wielkiej Niedźwiedzicy. Przedłużenie tylnej ściany wskazuje Gwiazdę Polarną.","lines":[[[13.79235,49.3133],[13.39875,54.9254],[12.90047,55.9598],[12.25709,57.0326],[11.06216,61.751],[11.03068,56.3824],[11.89717,53.6948],[12.25709,57.0326]]],"center":[12.38159,56.5818]},{"id":"CoH","pl":"Wieszak","en":"Coathanger","note":"Gromada Brocchiego w Lisku. Przez lornetkę wygląda jak wieszak na ubrania.","lines":[[[19.48914,20.2797],[19.42289,20.2717],[19.39637,20.2644]],[[19.43701,20.0977],[19.4413,19.8915],[19.42461,19.7984]]],"center":[19.43522,20.1011]},{"id":"Ptr","pl":"Wskaźniki","en":"The Pointers","note":"Dubhe i Merak. Odcinek między nimi przedłużony pięciokrotnie trafia w Gwiazdę Polarną.","lines":[[[14.66076,-60.834],[14.06373,-60.373],[12.79536,-59.6888]]],"center":[13.83092,-60.8123]},{"id":"KSt","pl":"Zwornik Herkulesa","en":"Keystone","note":"Czworobok w środku Herkulesa. Na jego zachodniej krawędzi leży gromada M13.","lines":[[[17.00483,30.9264],[16.68811,31.6027],[16.71493,38.9223],[17.25079,36.8092],[17.00483,30.9264]]],"center":[16.93285,33.8754]},{"id":"Sal","pl":"Żagiel","en":"Sail","note":"Trapez gwiazd w Perseuszu i Andromedzie.","lines":[[[12.16875,-22.6198],[12.57312,-23.3968],[12.49774,-16.5154],[12.26344,-17.5419],[12.16875,-22.6198],[12.14022,-24.7289]]],"center":[12.30318,-21.2572]}]